<?xml version="1.0"?>
<glueball_0pp_corr_check>
  <Output>
    <summary_file>@OUTPUT_ROOT@/full_lattice.measurement.summary.xml</summary_file>
    <csv_file>@OUTPUT_ROOT@/full_lattice.measurement.csv</csv_file>
  </Output>

  <Geometry>
    <nrow>8 8 8 8</nrow>
    <decay_dir>3</decay_dir>
  </Geometry>

  <Reducer>
    <mode>MEASURE_CONFIG</mode>
  </Reducer>

  <Measurement>
    <child_id>-1</child_id>
    <stream_id>0</stream_id>
    <update_no>@UPDATE_NO@</update_no>
    <bl_level_selected>@BL_LEVEL_SELECTED@</bl_level_selected>
    <BlkAccu>1.0e-5</BlkAccu>
    <BlkMax>50</BlkMax>
  </Measurement>

  <Cfg>
    <cfg_type>SCIDAC</cfg_type>
    <cfg_file>@CFG_FILE@</cfg_file>
  </Cfg>
</glueball_0pp_corr_check>
