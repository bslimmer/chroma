        <dt>1</dt>
        <value>8</value>
      </elem>
      <elem>
        <dt>2</dt>
        <value>8</value>
      </elem>
      <elem>
        <dt>3</dt>
        <value>8</value>
      </elem>
      <elem>
        <dt>4</dt>
        <value>8</value>
      </elem>
    </expected_num_sources>
  </Checks>
</glueball_0pp_corr_check>
