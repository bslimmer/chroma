<?xml version="1.0"?>
<Params>
  <MCControl>
    <Cfg>
      <cfg_type>@PARENT_START_CFG_TYPE@</cfg_type>
      <cfg_file>@PARENT_START_CFG_FILE@</cfg_file>
    </Cfg>

    <RNG>
      <Seed>
        <elem>@PARENT_SEED@</elem>
        <elem>0</elem>
        <elem>0</elem>
        <elem>0</elem>
      </Seed>
    </RNG>

    <StartUpdateNum>@PARENT_START_UPDATE@</StartUpdateNum>
    <NWarmUpUpdates>0</NWarmUpUpdates>
    <NProductionUpdates>@PARENT_UPDATES_THIS_RUN@</NProductionUpdates>
    <NUpdatesThisRun>@PARENT_UPDATES_THIS_RUN@</NUpdatesThisRun>
    <SaveInterval>@OUTER_SAVE_INTERVAL@</SaveInterval>
    <SavePrefix>@OUTPUT_ROOT@/parent_outer</SavePrefix>
    <SaveVolfmt>SINGLEFILE</SaveVolfmt>
    <ReproCheckP>false</ReproCheckP>
    <ReverseCheckP>false</ReverseCheckP>
    <MonitorForces>true</MonitorForces>
  </MCControl>

  <HMCTrj>
    <Monomials>
      <elem>
        <Name>GAUGE_MONOMIAL</Name>
        <GaugeAction>
          <Name>WILSON_GAUGEACT</Name>
          <beta>5.7</beta>
          <GaugeBC>
            <Name>PERIODIC_GAUGEBC</Name>
          </GaugeBC>
        </GaugeAction>
        <NamedObject>
          <monomial_id>gauge</monomial_id>
        </NamedObject>
      </elem>
    </Monomials>

    <Hamiltonian>
      <monomial_ids>
        <elem>gauge</elem>
      </monomial_ids>
    </Hamiltonian>

    <MDIntegrator>
      <tau0>0.1</tau0>
      <Integrator>
        <Name>LCM_STS_LEAPFROG</Name>
        <n_steps>15</n_steps>
        <monomial_ids>
          <elem>gauge</elem>
        </monomial_ids>
      </Integrator>
    </MDIntegrator>

    <nrow>8 8 8 8</nrow>
  </HMCTrj>
</Params>
