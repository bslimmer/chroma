<?xml version="1.0"?>
<chroma>
<annotation>
;
; Small smoke-test for PROP_AND_MATELEM_DISTILLATION_SUPERB
; on a 2^3 x 8 disordered (random) gauge field.
;
; Chain:
;   1) DISORDERED Cfg -> default_gauge_field (random SU(Nc) links)
;   2) CREATE_COLORVECS -> a handful of smeared eigenvectors
;   3) WRITE_TIMESLICE_MAP_OBJECT_DISK -> dump them to colorvec_test.mod
;   4) PROP_AND_MATELEM_DISTILLATION_SUPERB -> the measurement under test
;
</annotation>
<Param>
  <InlineMeasurements>

    <elem>
      <annotation>
        Build a small set of colorvecs to feed the distillation propagator step.
        num_vecs is kept small (4) since a 2x2x2 spatial volume only supports
        Nc*Vol3 = 3*8 = 24 independent color components.
      </annotation>
      <Name>CREATE_COLORVECS</Name>
      <Frequency>1</Frequency>
      <Param>
        <num_vecs>4</num_vecs>
        <decay_dir>3</decay_dir>
        <num_iter>50</num_iter>
        <width>3.0</width>
        <num_orthog>20</num_orthog>
        <LinkSmearing>
          <LinkSmearingType>STOUT_SMEAR</LinkSmearingType>
          <link_smear_fact>0.1625</link_smear_fact>
          <link_smear_num>4</link_smear_num>
          <no_smear_dir>3</no_smear_dir>
        </LinkSmearing>
      </Param>
      <NamedObject>
        <gauge_id>default_gauge_field</gauge_id>
        <colorvec_id>eigeninfo_0</colorvec_id>
        <ColorVecMapObject>
          <MapObjType>MAP_OBJECT_MEMORY</MapObjType>
        </ColorVecMapObject>
      </NamedObject>
    </elem>

    <elem>
      <annotation>
        Dump the colorvecs to disk so they can be read back in via colorvec_files.
      </annotation>
      <Name>WRITE_TIMESLICE_MAP_OBJECT_DISK</Name>
      <Frequency>1</Frequency>
      <NamedObject>
        <object_type>KeyTintValTLatticeColorVector</object_type>
        <input_id>eigeninfo_0</input_id>
        <output_file>./colorvec_test.mod</output_file>
      </NamedObject>
    </elem>

    <elem>
      <annotation>
        The measurement under test.
      </annotation>
      <Name>PROP_AND_MATELEM_DISTILLATION_SUPERB</Name>
      <Frequency>1</Frequency>
      <Param>
        <Contractions>
          <mass_label>U0.1</mass_label>
          <num_vecs>4</num_vecs>
          <t_sources>0</t_sources>
          <decay_dir>3</decay_dir>
          <Nt_forward>8</Nt_forward>
          <Nt_backward>0</Nt_backward>
          <max_rhs>4</max_rhs>
          <use_superb_format>true</use_superb_format>
          <use_device_for_contractions>false</use_device_for_contractions>
          <output_file_is_local>true</output_file_is_local>
        </Contractions>
        <Propagator>
          <version>10</version>
          <quarkSpinType>FULL</quarkSpinType>
          <obsvP>false</obsvP>
          <numRetries>1</numRetries>
          <FermionAction>
            <FermAct>CLOVER</FermAct>
            <Mass>0.1</Mass>
            <clovCoeff>1.0</clovCoeff>
            <AnisoParam>
              <anisoP>false</anisoP>
            </AnisoParam>
            <FermionBC>
              <FermBC>SIMPLE_FERMBC</FermBC>
              <boundary>1 1 1 -1</boundary>
            </FermionBC>
          </FermionAction>
          <InvertParam>
            <invType>CG_INVERTER</invType>
            <RsdCG>1.0e-8</RsdCG>
            <MaxCG>1000</MaxCG>
          </InvertParam>
        </Propagator>
      </Param>
      <NamedObject>
        <gauge_id>default_gauge_field</gauge_id>
        <colorvec_files>
          <elem>./colorvec_test.mod</elem>
        </colorvec_files>
	<prop_op_file>./peram_test.sdb</prop_op_file>
	<frozen_boundary_sidecar_file>./gauge_subdomain_split_test.xml</frozen_boundary_sidecar_file>
	<frozen_boundary_child_id>0</frozen_boundary_child_id>
      </NamedObject>
    </elem>

  </InlineMeasurements>
  <nrow>2 2 2 8</nrow>
</Param>

<RNG>
  <Seed>
    <elem>11</elem>
    <elem>11</elem>
    <elem>11</elem>
    <elem>0</elem>
  </Seed>
</RNG>

<Cfg>
  <cfg_type>DISORDERED</cfg_type>
  <cfg_file>dummy</cfg_file>
</Cfg>
</chroma>
