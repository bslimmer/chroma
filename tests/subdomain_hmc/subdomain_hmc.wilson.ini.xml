<?xml version="1.0"?>
<Params>
  <SubdomainHMC>
    <nrow>4 4 4 8</nrow>

    <Start>
      <Mode>FROM_PARENT_CFG</Mode>
      <Cfg>
        <cfg_type>WEAK_FIELD</cfg_type>
        <cfg_file>DUMMY</cfg_file>
      </Cfg>
      <Split>
        <t_dir>3</t_dir>
        <cut0>1</cut0>
        <cut1>5</cut1>
        <frozen_width>1</frozen_width>
      </Split>
    </Start>

    <SharedHMC>
      <Boundary>
        <GaugeBC>SUBDOMAIN_FIXED_GAUGEBC</GaugeBC>
        <loop_extent>2</loop_extent>
      </Boundary>
      <Monomials>
        <elem>
          <Name>GAUGE_MONOMIAL</Name>
          <GaugeAction>
            <Name>WILSON_GAUGEACT</Name>
            <beta>5.7299</beta>
            <GaugeBC>
              <Name>PERIODIC_GAUGEBC</Name>
            </GaugeBC>
          </GaugeAction>
          <NamedObject>
            <monomial_id>gauge</monomial_id>
          </NamedObject>
        </elem>
      </Monomials>
      <Hamiltonian>
        <monomial_ids>
          <elem>gauge</elem>
        </monomial_ids>
      </Hamiltonian>
      <MDIntegrator>
        <tau0>0.05</tau0>
        <Integrator>
          <Name>LCM_STS_LEAPFROG</Name>
          <n_steps>4</n_steps>
          <monomial_ids>
            <elem>gauge</elem>
          </monomial_ids>
        </Integrator>
      </MDIntegrator>
    </SharedHMC>

    <Child0>
      <ChainControl>
        <RNG>
          <Seed>
            <elem>11</elem>
            <elem>0</elem>
            <elem>0</elem>
            <elem>0</elem>
          </Seed>
        </RNG>
        <StartUpdateNum>0</StartUpdateNum>
        <NWarmUpUpdates>0</NWarmUpUpdates>
        <NProductionUpdates>1</NProductionUpdates>
        <NUpdatesThisRun>1</NUpdatesThisRun>
        <SaveInterval>1</SaveInterval>
        <SavePrefix>/private/tmp/chroma-build/chroma-subdomain-hmc/mainprogs/tests/subdomain_hmc.child0</SavePrefix>
        <SaveVolfmt>SINGLEFILE</SaveVolfmt>
        <ParallelIO>false</ParallelIO>
        <ReproCheckP>false</ReproCheckP>
        <ReverseCheckP>false</ReverseCheckP>
        <MonitorForces>false</MonitorForces>
      </ChainControl>
      <InlineMeasurements>
        <elem>
          <Name>PLAQUETTE</Name>
          <Frequency>1</Frequency>
          <Param>
            <version>2</version>
          </Param>
          <NamedObject>
            <gauge_id>default_gauge_field</gauge_id>
          </NamedObject>
        </elem>
      </InlineMeasurements>
    </Child0>

    <Child1>
      <ChainControl>
        <RNG>
          <Seed>
            <elem>22</elem>
            <elem>0</elem>
            <elem>0</elem>
            <elem>0</elem>
          </Seed>
        </RNG>
        <StartUpdateNum>0</StartUpdateNum>
        <NWarmUpUpdates>0</NWarmUpUpdates>
        <NProductionUpdates>2</NProductionUpdates>
        <NUpdatesThisRun>2</NUpdatesThisRun>
        <SaveInterval>1</SaveInterval>
        <SavePrefix>/private/tmp/chroma-build/chroma-subdomain-hmc/mainprogs/tests/subdomain_hmc.child1</SavePrefix>
        <SaveVolfmt>SINGLEFILE</SaveVolfmt>
        <ParallelIO>false</ParallelIO>
        <ReproCheckP>false</ReproCheckP>
        <ReverseCheckP>false</ReverseCheckP>
        <MonitorForces>false</MonitorForces>
      </ChainControl>
      <InlineMeasurements>
        <elem>
          <Name>PLAQUETTE</Name>
          <Frequency>2</Frequency>
          <Param>
            <version>2</version>
          </Param>
          <NamedObject>
            <gauge_id>default_gauge_field</gauge_id>
          </NamedObject>
        </elem>
      </InlineMeasurements>
    </Child1>

    <Outputs>
      <StitchAtEnd>true</StitchAtEnd>
      <WriteStitchedParent>true</WriteStitchedParent>
      <KeepChildRestartArtifacts>true</KeepChildRestartArtifacts>
      <ChildRestartManifestFile>/private/tmp/chroma-build/chroma-subdomain-hmc/mainprogs/tests/subdomain_hmc.child_restart.xml</ChildRestartManifestFile>
      <StitchedParentFile>/private/tmp/chroma-build/chroma-subdomain-hmc/mainprogs/tests/subdomain_hmc.parent.lime</StitchedParentFile>
      <StitchedParentSaveVolfmt>SINGLEFILE</StitchedParentSaveVolfmt>
      <StitchedParentParallelIO>false</StitchedParentParallelIO>
      <PostStitchInlineMeasurements>
      </PostStitchInlineMeasurements>
    </Outputs>
  </SubdomainHMC>
</Params>
